ANTHROPIC_API_KEY=your_anthropic_api_key
# Claude model used to generate the schedule.
# Options: claude-haiku-4-5 (fast, cheap), claude-sonnet-4-6 (balanced), claude-opus-4-8 (most capable)
CLAUDE_MODEL=claude-haiku-4-5
CLICKUP_TOKEN=your_clickup_personal_api_token
# CLICKUP_TEAM_ID is optional if you only have one ClickUp workspace.
# If you have multiple workspaces, set this to the ID of the one to use.
CLICKUP_TEAM_ID=
# Comma-separated list of ClickUp status names to include when fetching tasks.
CLICKUP_STATUSES=Open,In Progress
# The calendar where scheduled time blocks will be created.
GOOGLE_CALENDAR_ID=primary
# Comma-separated list of calendars to check for conflicts before scheduling.
# Include every calendar that has meetings or personal appointments.
# Use 'primary' for your main calendar, or paste a calendar ID from Google Calendar settings.
BUSY_CALENDARS=primary
SCHEDULE_BLOCK_COLOR=7
